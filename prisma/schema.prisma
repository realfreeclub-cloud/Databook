// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String          @id @default(cuid())
  phone                 String          @unique
  password              String
  name                  String?
  role                  String          @default("USER") // "USER" | "SUPER_ADMIN"
  subscriptionActive    Boolean         @default(false)
  subscriptionPlan      String?
  subscriptionExpiresAt DateTime?
  pendingPlan           String?
  pendingMonths         Int?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  records               RepairRecord[]
  inventoryItems        InventoryItem[]
  saleItems             SaleItem[]
}

model RepairRecord {
  id                   String   @id @default(cuid())
  jobNumber            String   @unique
  name                 String
  phone                String
  laptop               String
  password             String?
  issue                String
  extraProblem         String?
  chargerCollected     Boolean  @default(false)
  signature            Boolean  @default(false)
  workStatus           String   @default("Pending")
  amount               Float
  isPaid               Boolean  @default(false)
  pendingAmount        Float?   @default(0)
  receivedDate         String
  expectedDeliveryDate String
  completedDate        String?
  actualDeliveryDate   String?
  finalStatus          String   @default("Complete")
  notes                String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model InventoryItem {
  id        String     @id @default(cuid())
  name      String
  sku       String?
  stock     Int        @default(0)
  price     Float      @default(0)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  sales     SaleItem[]
}

model SaleItem {
  id              String        @id @default(cuid())
  quantity        Int
  totalAmount     Float
  saleDate        DateTime      @default(now())
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model SupportRequest {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  message   String
  status    String   @default("PENDING") // "PENDING" | "RESOLVED"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
